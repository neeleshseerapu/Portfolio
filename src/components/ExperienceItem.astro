---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  item: CollectionEntry<'experience'>;
}
const { item } = Astro.props;
const { role, company, start, end, location } = item.data;
const { Content } = await render(item);
---
<article class="log">
  <h3>{role}, {company}</h3>
  <p class="muted">[{start} to {end}]{location && ` ${location}`}</p>
  <div class="lines"><Content /></div>
</article>

<style>
  .log { border-left: 2px solid var(--line); padding: 0.25rem 0 0.25rem 1.25rem; }
  .log + .log { margin-top: 1.75rem; }
  .log p { margin: 0.35rem 0; }
</style>
