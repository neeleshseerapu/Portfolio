---
import { render, type CollectionEntry } from 'astro:content';
import { site } from '@/data/site';
import { getProjects } from '@/lib/content';
import { graph, person, sourceCode } from '@/lib/jsonld';
import Base from '@/layouts/Base.astro';
import FeaturedProject from '@/components/FeaturedProject.astro';

export async function getStaticPaths() {
  return (await getProjects()).map((project) => ({ params: { slug: project.data.slug }, props: { project } }));
}

const { project } = Astro.props as { project: CollectionEntry<'projects'> };
const { Content } = await render(project);
const jsonLd = graph(person(Astro.site), sourceCode(project, Astro.site));
---
<Base title={`~/neelesh/${project.data.slug} · ${site.name}`} description={project.data.oneLiner} jsonLd={jsonLd}>
  <nav aria-label="Breadcrumb" class="links" style="margin-bottom: 1.5rem"><a href="/">Home</a></nav>
  <p class="prompt" aria-hidden="true" style="margin-bottom: 0.75rem">cat projects/{project.data.slug}.md</p>
  <FeaturedProject project={project} as="h1" />
  <section aria-labelledby="writeup" class="lines">
    <h2 id="writeup" data-cmd="cat" data-ext=".md">writeup</h2>
    <Content />
  </section>
</Base>
